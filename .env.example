# Copier ce fichier vers .env. Ne jamais ajouter .env à Git.
APP_ENV=development
# Facultatif : le défaut est var/impactflow.sqlite3 dans le dépôt.
# Un autre emplacement doit utiliser un chemin absolu :
# DATABASE_URL=sqlite:////chemin/absolu/impactflow.sqlite3
APP_BASE_URL=http://127.0.0.1:8000
SESSION_TTL_SECONDS=28800
INVITATION_TTL_HOURS=48
# Simulation locale : aucun e-mail réel, boîte réservée au super-admin.
MAILER_BACKEND=memory
# Pour un compte gratuit Brevo et un expéditeur validé : voir README.md (section Configuration et e-mails).
# MAILER_BACKEND=brevo
# MAIL_FROM_EMAIL=votre-expediteur-valide
# MAIL_FROM_NAME=ImpactFlow
# BREVO_API_KEY=cle-privee-a-conserver-uniquement-dans-env

# SMTP de test gratuit : lancer scripts/mailpit.sh, interface sur le port 8025.
# MAILER_BACKEND=mailpit
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAILPIT_UI_URL=http://127.0.0.1:8025
# Fenêtre fixe depuis le PREMIER changement, jamais repoussée.
BATCH_WINDOW_SECONDS=60
# Limites globales pour tous les e-mails : une tentative, aucun réessai automatique.
SEND_MAX_PER_PERIOD=2
SEND_PERIOD_SECONDS=1
SEND_DAILY_LIMIT=300
# Un seul processus Uvicorn ; worker actif hors APP_ENV=test par défaut.
# APP_WORKER_ENABLED=true
